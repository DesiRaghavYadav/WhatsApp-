rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (default deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow read/write to 'files', 'users', 'group_invites', and 'app_data' collections for server-side persistence
    match /files/{fileId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /group_invites/{inviteId} {
      allow read, write: if true;
    }
    match /app_data/{docId} {
      allow read, write: if true;
    }
  }
}
